# Keep the build context small and free of host artifacts. Every exclusion here
# is either regenerated inside the image or must never be baked into it.

# dependencies — the image installs its own from package-lock.json
node_modules

# next build output — produced by the build stage
.next
out

# generated Prisma client — `prisma generate` runs in the build stage
src/generated

# secrets — passed in at runtime by compose, never copied into a layer
.env
.env.*
!.env.example
!.env.test.example
!.env.local.example

# tests, fixtures and coverage are not needed to build or run the app
coverage
tests

# local editor / OS noise
.git
.gitignore
.vscode
.idea
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
