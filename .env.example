# ---------------------------------------------------------------------------
# Copy to `.env` for local development:  cp .env.example .env
# Every variable below is validated at startup by src/lib/env.ts.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Used by the Prisma CLI (migrations) and, unless DIRECT_DATABASE_URL is set,
# by the application at runtime.
DATABASE_URL=postgresql://jts:jts_dev_password@localhost:5432/jobsearch_crm?schema=public
# Optional. Set this when the runtime should use a pooled connection while
# migrations run against a direct one (PgBouncer, Supabase pooler, etc).
# DIRECT_DATABASE_URL=
# Required by `prisma migrate dev` so schema drift can be detected. Point it at
# a separate, disposable database.
SHADOW_DATABASE_URL=postgresql://jts:jts_dev_password@localhost:5432/jobsearch_crm_shadow?schema=public

# --- Auth -------------------------------------------------------------------
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=dev-only-secret-change-me-to-48-random-characters-min
# Session lifetime in days (sliding).
SESSION_TTL_DAYS=30
# Set to 1 to disable self-service registration (admin provisions accounts only).
ALLOW_REGISTRATION=1

# --- Outbound email ---------------------------------------------------------
# The app NEVER pretends to send mail. When these are unset the "Send" action is
# disabled in the UI and the server action returns MAILER_NOT_CONFIGURED.
# For local development, `docker compose up -d mailpit` gives you a real SMTP
# server on 1025 with a web UI on 8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# The address cold outreach is sent from. Should be a domain you control and
# have SPF/DKIM/DMARC configured for.
SMTP_FROM_EMAIL=you@example.com
SMTP_FROM_NAME=Your Name

# --- Inbound email ----------------------------------------------------------
# Shared secret for POST /api/webhooks/email-inbound. Point your mail provider's
# inbound webhook here, or leave unset to disable inbound replies entirely.
EMAIL_INBOUND_SECRET=
